#NEXUS
begin taxa;
  dimensions ntax=3;
  taxlabels
    seq1
    seq2
    seq3
  ;
end;

begin trees;
  translate
    1 seq1,
    2 seq2,
    3 seq3,
  ;
  tree annotated = [&U] ((1:0.10000,2:0.20000):0.30000,3:0.40000):0.00000;

end;

begin characters;
  dimensions nchar=9;
  format datatype=dna missing=? gap=-;
  matrix
    seq1	ACGT-ACGT
    seq2	ACGTACGT-
    seq3	ACGTACGTG
  ;
end;
