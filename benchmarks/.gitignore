# Downloaded / auto-generated datasets (see data/README.md). Keep the
# download scripts, drop everything they produce. Use `data/<dir>/*` (not
# `data/<dir>/`) so individual whitelisted files can be re-included below.
data/1kg/*
data/peter2018/*
data/orthofinder/*
data/hmmer/*
data/y1000plus/*

# Stage 1 (bench/stage1-fairness): commit a 20-species Y1000+ tRNA-scan
# slice (~1.7 MB) as the T3/T4/T5 reference input. Full-genome FASTAs
# (.fa, .fa.gz) stay ignored; only the small .fasta/.gff pair is shipped.
!data/y1000plus/*.fasta
!data/y1000plus/*.gff
!data/y1000plus/*.gff3

# Benchmark results are regenerated by run_bench.sh; don't track them.
results/raw/*.tsv
results/figures/*.png
results/figures/*.pdf
results/figures/*.svg
results/figures/*.md
results/figures/*.csv
results/results.*.tar.gz
results/hardware.log

# Keep the empty-dir markers.
!results/raw/.gitkeep
!results/figures/.gitkeep

# Hand-script generated by T1.
tasks/_T1_handscript.sh

# HTCondor log files (one set per cluster ID).
condor/logs/bench.*.log
condor/logs/bench.*.out
condor/logs/bench.*.err
!condor/logs/.gitkeep
